{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betrayal-sound-effect",
  "compatibility_date": "2026-08-08",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  // Attached to the shared hostname by path-scoped Routes, NOT a Custom Domain
  // — the `games` hub Worker holds that. Cloudflare matches the most-specific
  // route first, so these peel /betrayal_sound_board off the hub.
  // Two patterns: `/*` does not match the bare prefix, and the bare prefix is
  // what src/index.js redirects to the trailing-slash form.
  "routes": [
    { "pattern": "games.csiesheep.com/betrayal_sound_board", "zone_name": "csiesheep.com" },
    { "pattern": "games.csiesheep.com/betrayal_sound_board/*", "zone_name": "csiesheep.com" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
