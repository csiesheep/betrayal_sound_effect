{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betrayal-sound-effect",
  "compatibility_date": "2026-08-08",
  "main": "src/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
